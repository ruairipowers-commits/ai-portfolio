# Copy to .env on the demo host (git-ignored). Nothing here is committed.
# Public base URL of the demos (Cloudflare Tunnel hostname):
DEMOS_URL=https://demos.example.com
# Used for "Blog post" / "Source code" links inside the apps:
SITE_URL=https://your-user.github.io/ai-portfolio
GITHUB_OWNER=your-github-user
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → "Install connector" token:
TUNNEL_TOKEN=
# Long random strings (python3 -c "import secrets; print(secrets.token_urlsafe(32))"):
GOVERNANCE_INGEST_TOKEN=
GOVERNANCE_ADMIN_TOKEN=
# Optional: Postgres for the console (default: SQLite in a Docker volume, which persists on this machine)
GOVERNANCE_DATABASE_URL=
# Where the local proxy listens. 127.0.0.1 = only the tunnel and this machine; your Tailscale IP to browse it privately.
DEMOS_BIND=127.0.0.1
DEMOS_PORT=8088
# Continuous deployment: deploy a commit only after its GitHub checks pass (set 1 to skip the gate)
DEPLOY_SKIP_CI=0
# Optional read-only GitHub token (private repo, or more than 60 API requests an hour)
GITHUB_TOKEN=
# Governance alert emails from the console. Resend (resend.com, free tier): verify your sending domain, create an
# API key, and use it as the password; SMTP_FROM must be on the verified domain. Gmail also works with an app password
# (smtp.gmail.com, your address as user). Leave SMTP_* empty to keep alerts in the console's outbox only.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=
GOVERNANCE_ALERT_EMAIL=
# --- Site assistant (Ask button on the blog) ------------------------------------------------------------------
# Local model for answers (pulled automatically on first start). Any Ollama chat model works; compare candidates
# on this machine first:  docker compose … exec site-assistant siteassist bench qwen3.5:9b gemma4:e4b llama3.1:8b
OLLAMA_MODEL=qwen3.5:9b
# Reasoning models (qwen3.5, gemma4): false = answer directly, much faster. Leave empty for models without it.
OLLAMA_THINK=false
# CPU threads for the model (empty = Ollama decides). Physical cores usually beat logical ones.
OLLAMA_NUM_THREAD=
# CPU by default. For the AMD iGPU (Vulkan) see README → "Faster answers".
OLLAMA_IMAGE=ollama/ollama:latest
# Daily engagement email (defaults to GOVERNANCE_ALERT_EMAIL) and the owner's /stats page token
DIGEST_EMAIL=
ASSISTANT_ADMIN_TOKEN=
# Cloudflare analytics: API token with Zone → Analytics → Read, and the zone ID (Overview page of agentls.com)
CF_API_TOKEN=
CF_ZONE_ID=
# GitHub traffic: fine-grained token, repository permission "Administration: Read-only" on the repos below
GITHUB_TRAFFIC_TOKEN=
GITHUB_REPOS=
