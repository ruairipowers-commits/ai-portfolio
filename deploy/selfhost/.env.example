# Copy to .env on the demo host (git-ignored). Nothing here is committed.
# Public base URL of the demos (Cloudflare Tunnel hostname):
DEMOS_URL=https://demos.example.com
# Used for "Blog post" / "Source code" links inside the apps:
SITE_URL=https://your-user.github.io/ai-portfolio
GITHUB_OWNER=your-github-user
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → "Install connector" token:
TUNNEL_TOKEN=
# Long random strings (python3 -c "import secrets; print(secrets.token_urlsafe(32))"):
GOVERNANCE_INGEST_TOKEN=
GOVERNANCE_ADMIN_TOKEN=
# Optional: Postgres for the console (default: SQLite in a Docker volume, which persists on this machine)
GOVERNANCE_DATABASE_URL=
# Where the local proxy listens. 127.0.0.1 = only the tunnel and this machine; your Tailscale IP to browse it privately.
DEMOS_BIND=127.0.0.1
DEMOS_PORT=8088
# Continuous deployment: deploy a commit only after its GitHub checks pass (set 1 to skip the gate)
DEPLOY_SKIP_CI=0
# Optional read-only GitHub token (private repo, or more than 60 API requests an hour)
GITHUB_TOKEN=
