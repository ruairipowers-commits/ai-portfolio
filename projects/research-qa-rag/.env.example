# SEC-01: copy to .env (git-ignored) or inject from a secret manager. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Bedrock uses the standard AWS credential chain (SSO profile / role), not a key here:
AWS_PROFILE=
# Governance hub (optional): where run events go. Default ~/.ai-governance/governance.sqlite
# GOVERNANCE_DATABASE_URL=postgresql://gov_writer:...@host/governance
# GOVERNANCE_TELEMETRY=off
