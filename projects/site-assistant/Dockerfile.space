# Live service image (self-host / Hugging Face Space, Docker SDK). Local equivalent:
#   docker build -f Dockerfile.space -t site-assistant . && docker run -p 7860:7860 -e PORTFOLIO_SITE_URL=… site-assistant
# Reads the blog's search index from $PORTFOLIO_SITE_URL/search/search_index.json at start and every hour.
# Answers with a local model when OLLAMA_URL points at Ollama (the self-host stack runs one); otherwise it quotes
# the best passages. No API keys.
FROM python:3.11-slim
# /app must belong to the app user (the activity log lives in /app/warehouse, a Docker volume when self-hosted)
RUN useradd -m -u 1000 user && install -d -o user -g user /app
ENV HOME=/home/user PATH=/home/user/.local/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR /app
COPY --chown=user . .
USER user
RUN pip install --no-cache-dir --user -e . && mkdir -p warehouse
ENV PORTFOLIO_DEMO=1 HOST=0.0.0.0 PORT=7860
EXPOSE 7860
CMD ["siteassist", "serve"]
