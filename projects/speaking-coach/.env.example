# SEC-01: copy to .env (git-ignored) or inject from a secret manager. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Bedrock uses the standard AWS credential chain (SSO profile / role), not a key here:
AWS_PROFILE=
# Local models (privacy.local_only friendly): Ollama on this machine or the EVO-X1
OLLAMA_URL=http://localhost:11434
# Override the model aliases without editing config/models.yaml
COACH_DISAMBIGUATOR_MODEL=
COACH_COACH_MODEL=
