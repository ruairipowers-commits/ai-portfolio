# Hosted demo image. Local equivalent:
#   docker build -f Dockerfile.space -t backtester-demo . && docker run -p 7860:7860 backtester-demo
# Mock model only: no API keys are needed or read. Each visitor gets a private copy of the data.
# Custom strategy code is disabled when PORTFOLIO_DEMO=1 (it would run on a shared server).
# Two stages: the C++ compiler is only needed to build the kernel.
FROM python:3.11-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 user && install -d -o user -g user /app
USER user
ENV HOME=/home/user PATH=/home/user/.local/bin:$PATH
WORKDIR /app
COPY --chown=user . .
RUN pip install --no-cache-dir --user -e ".[ui]"
# Pre-build the baseline every visitor's sandbox is copied from (synthetic ticks + one run).
RUN GOVERNANCE_TELEMETRY=off event-backtester all && rm -rf build

FROM python:3.11-slim
RUN useradd -m -u 1000 user && install -d -o user -g user /app
ENV HOME=/home/user PATH=/home/user/.local/bin:$PATH PYTHONUNBUFFERED=1 PORTFOLIO_DEMO=1
WORKDIR /app
COPY --from=build --chown=user /home/user/.local /home/user/.local
COPY --from=build --chown=user /app /app
USER user
EXPOSE 7860
CMD ["streamlit", "run", "src/event_backtester/ui.py", "--server.port=7860", "--server.address=0.0.0.0", \
     "--server.headless=true", "--server.enableXsrfProtection=false", "--server.enableCORS=false"]
