# SEC-01: copy to .env (git-ignored) or inject from a secret manager. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Bedrock uses the standard AWS credential chain (SSO profile / role), not a key here:
AWS_PROFILE=
# Optional: a Hugging Face token raises Hub rate limits for `dlp fetch` and live search (read-only scope is enough)
HF_TOKEN=
# Marketplace adapters (only needed to take them off the recorded fixtures)
SNOWFLAKE_ACCOUNT=
AWS_DATA_EXCHANGE_ROLE_ARN=
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# The API: per-tenant bearer tokens are issued by `dlp api-token`; this signs them
DLP_TOKEN_SECRET=
