# Copy to .env (git-ignored). Nothing here is needed for the offline demo (`puzzle all`, `puzzle ui`).
# --- required in the live service (PUZZLE_REQUIRE_SECRETS=1 refuses the development defaults) ---
PUZZLE_KEY_SECRET=          # encrypts answer keys until close:  openssl rand -hex 32   (don't rotate mid-puzzle)
PUZZLE_SALT=                # HMAC salt for answer hashes and unsubscribe links:  openssl rand -hex 32
PUZZLE_ADMIN_TOKEN=         # operator page /admin:  openssl rand -hex 24
# --- email (Resend) ---
RESEND_API_KEY=
MAIL_FROM="Daily puzzle <puzzle@your-domain>"
PUZZLE_OPERATOR_EMAIL=      # where escalations go
PUZZLE_PUBLIC_URL=          # e.g. https://demos.example.com/daily-puzzle (links in emails)
# --- models (optional; default is the offline mock pair) ---
PUZZLE_GENERATOR_MODEL=     # a model name from config/models.yaml, e.g. local-qwen or claude-sonnet
PUZZLE_SOLVER_MODEL=        # a DIFFERENT model, e.g. local-gemma or claude-haiku
OLLAMA_URL=                 # http://localhost:11434
ANTHROPIC_API_KEY=
# --- live Hugging Face assets (optional) ---
PUZZLE_LIVE_ASSETS=0        # 1: check Hub licences and fetch allow-listed files (pip install '.[hub]')
HF_TOKEN=                   # read-only; never passed into the sandbox
# --- governance console ---
GOVERNANCE_URL=
GOVERNANCE_INGEST_TOKEN=
