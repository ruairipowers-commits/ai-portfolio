# SEC-01: copy to .env (git-ignored) or inject from a secret manager. Never commit real values.
# Signs sign-in links, sessions and the calendar-feed URL. Required when HELPER_ENV=production:
#   openssl rand -hex 32
HELPER_SECRET=
HELPER_ENV=development
# Where sign-in links point (the app's scheme), and allowed web origins for the API
HELPER_APP_LINK=lilhelper://signin
HELPER_CORS=*
# The address in calendar feeds and one-tap links (https://helper.example.com in production)
HELPER_PUBLIC_URL=http://localhost:8650
# Where accounts and each household's folder live (default: ./warehouse)
HELPER_DATA=
# Who can start a household: invite (needs a code below) | open | closed. Joining by invite always works.
HELPER_SIGNUP=invite
HELPER_SIGNUP_CODES=
# Push notifications: expo sends through Expo's push service; anything else writes them to output/outbox/
HELPER_PUSH=
EXPO_ACCESS_TOKEN=
# Run the scheduler (drafts, emails, trip reminders, "how was dinner?") inside the API, every N minutes
HELPER_SCHEDULER=0
HELPER_TICK_MINUTES=15
# Email (Resend). Without a key, emails are written to output/outbox/
RESEND_API_KEY=
HELPER_MAIL_FROM=Lil'Helper <helper@example.com>   # this app's sender; wins over MAIL_FROM
MAIL_FROM=                  # shared fallback
# Recipe search (optional): a Brave Search API key; without it, searches open in the person's browser
BRAVE_API_KEY=
# Instacart Developer Platform: turns delivery lists into shopping-list links (nothing is bought)
INSTACART_API_KEY=
INSTACART_ENV=development
# Models (optional; the mock runs with none). Local models keep everything at home:
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_PROFILE=
