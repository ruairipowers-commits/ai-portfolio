# SEC-01: copy to .env (git-ignored) or inject from a secret manager. Never commit real values.
# Signs sign-in links, sessions and the calendar-feed URL. Required when HELPER_ENV=production:
#   openssl rand -hex 32
HELPER_SECRET=
HELPER_ENV=development
# Where sign-in links point (the app's scheme), and allowed web origins for the API
HELPER_APP_LINK=lilhelper://signin
HELPER_CORS=*
# Run the Saturday draft / Sunday email / Wednesday restock jobs inside the API
HELPER_SCHEDULER=0
# Email (Resend). Without a key, emails are written to output/outbox/
RESEND_API_KEY=
MAIL_FROM=Lil'Helper <helper@example.com>
# Instacart Developer Platform: turns delivery lists into shopping-list links (nothing is bought)
INSTACART_API_KEY=
INSTACART_ENV=development
# Models (optional; the mock runs with none). Local models keep everything at home:
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_PROFILE=
