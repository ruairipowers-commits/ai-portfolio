{
  "expo": {
    "name": "DinnerPeace",
    "slug": "lil-helper",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lilhelper",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF6E0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agentls.lilhelper",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.agentls.lilhelper",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFF6E0"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "DinnerPeace reads store flyers you choose so it can find this week's specials.",
          "cameraPermission": "DinnerPeace reads store flyers you photograph so it can find this week's specials."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D7392A"
        }
      ],
      "expo-document-picker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "DinnerPeace listens when you tap the microphone, so you can say what you have or ask what's for dinner.",
          "speechRecognitionPermission": "DinnerPeace turns what you say into text to find recipes and answer questions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:8650",
      "router": {},
      "eas": {
        "projectId": "65b77174-e87a-4846-993d-f6d37705e654"
      }
    },
    "owner": "ruairipowers"
  }
}
