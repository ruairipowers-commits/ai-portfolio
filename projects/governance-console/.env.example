# SEC-01: copy to .env (git-ignored) or inject from a secret manager. Never commit real values.
# Workflows post events with this token (Authorization: Bearer …). Unset = accept unauthenticated (local only).
GOVERNANCE_INGEST_TOKEN=
# Unlocks kill-switch changes and attestations in the UI (/admin/login). Unset = admin open locally only.
GOVERNANCE_ADMIN_TOKEN=
# Durable store (Postgres). Unset = SQLite at warehouse/console.sqlite.
DATABASE_URL=
# Running inside the portfolio repo the catalog is read live; elsewhere set this to the repo root, or use the bundled catalog.
PORTFOLIO_ROOT=
