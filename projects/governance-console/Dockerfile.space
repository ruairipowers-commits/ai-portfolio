# Hosted demo image (Hugging Face Space, Docker SDK). Local equivalent:
#   docker build -f Dockerfile.space -t govconsole-demo . && docker run -p 7860:7860 govconsole-demo
# Space secrets (set by the portfolio's sync workflow): GOVERNANCE_INGEST_TOKEN (the demo apps post with it),
# GOVERNANCE_ADMIN_TOKEN (permanent kill-switch changes), optional DATABASE_URL (Postgres, so live history
# survives restarts — a free Space's disk is wiped when it sleeps).
FROM python:3.11-slim
RUN useradd -m -u 1000 user
ENV HOME=/home/user PATH=/home/user/.local/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR /app
COPY --chown=user . .
USER user
RUN pip install --no-cache-dir --user -e ".[postgres]"
ENV PORTFOLIO_DEMO=1 HOST=0.0.0.0 PORT=7860
EXPOSE 7860
# Simulated history is (re)seeded at start-up, relative to today; live events are never touched.
CMD ["govconsole", "serve"]
