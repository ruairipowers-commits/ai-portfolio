# SEC-01: copy to .env (git-ignored) or inject from a secret manager. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_PROFILE=
# HITL-02: key that signs approval tokens. Only the approval step and the write-scoped MCP server see it.
# If unset, a local dev key is generated in warehouse/.approval_key.
APPROVAL_SIGNING_KEY=
# Optional Postgres instead of SQLite (see docker-compose.yml):
# DATABASE_URL=postgresql://tradeops:tradeops@localhost:5432/tradeops
