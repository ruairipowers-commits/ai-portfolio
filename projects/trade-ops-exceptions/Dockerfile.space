# Hosted demo image (Hugging Face Space, Docker SDK). Local equivalent:
#   docker build -f Dockerfile.space -t tradeops-demo . && docker run -p 7860:7860 tradeops-demo
# Mock model only: no API keys are needed or read. Each visitor gets a private copy of the data.
FROM node:22-slim AS server
WORKDIR /srv
COPY mcp-server/package*.json ./
RUN npm install --no-audit --no-fund
COPY mcp-server/ ./
RUN npm run build && npm prune --omit=dev

FROM python:3.11-slim
# Node 22.13+ is required (node:sqlite); copy it from the build stage rather than the older distro package.
COPY --from=server /usr/local/bin/node /usr/local/bin/node
RUN useradd -m -u 1000 user
ENV HOME=/home/user PATH=/home/user/.local/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR /app
COPY --chown=user . .
COPY --from=server --chown=user /srv/dist ./mcp-server/dist
COPY --from=server --chown=user /srv/node_modules ./mcp-server/node_modules
USER user
RUN pip install --no-cache-dir --user -e ".[ui]"
# Pre-build the baseline every visitor's sandbox is copied from: 40 exceptions, all investigated.
RUN tradeops all
ENV PORTFOLIO_DEMO=1
EXPOSE 7860
CMD ["streamlit", "run", "src/tradeops/ui.py", "--server.port=7860", "--server.address=0.0.0.0", \
     "--server.headless=true", "--server.enableXsrfProtection=false", "--server.enableCORS=false"]
