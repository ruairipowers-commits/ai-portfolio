# SEC-01: copy to .env (git-ignored) or inject from a secret manager. Never commit real keys.
LAUNCHES_MODE=fixture          # fixture (offline, fictional) | live
LL2_API_KEY=                   # optional: a Launch Library 2 key raises their rate limit (the app's own budget still applies)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_PROFILE=                   # Bedrock uses the standard AWS credential chain
OLLAMA_URL=http://localhost:11434
