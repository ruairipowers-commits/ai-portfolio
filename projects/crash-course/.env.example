# Copy to .env (git-ignored). Nothing here is needed for the offline demo (`course all`, `course ui`, `course serve`).
# --- required in the live service (COURSE_REQUIRE_SECRETS=1 refuses the development default) ---
COURSE_SECRET=              # signs sessions, sign-in links and owner approval links:  openssl rand -hex 32
COURSE_OWNER_EMAIL=         # your email: approval requests go here, and signing in with it opens /owner
COURSE_PUBLIC_URL=          # e.g. https://demos.example.com/crash-course (links in emails)
# --- email (Resend) ---
RESEND_API_KEY=
MAIL_FROM="Crash course <courses@your-domain>"
# --- registration ---
COURSE_INVITE_CODES=        # only if registration.open is false: comma-separated codes
# --- models (optional; default is the offline mock) ---
COURSE_MODERATOR_MODEL=     # a model name from config/models.yaml, e.g. local-gemma
COURSE_WRITER_MODEL=        # e.g. local-qwen or claude-sonnet (after pricing it in models.yaml)
COURSE_REVISER_MODEL=
OLLAMA_URL=                 # http://localhost:11434
ANTHROPIC_API_KEY=
# --- governance console ---
GOVERNANCE_URL=
GOVERNANCE_INGEST_TOKEN=
