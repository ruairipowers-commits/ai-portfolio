# SEC-01: copy to .env (git-ignored) or inject from a secret manager. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_PROFILE=
# Postgres: default is an embedded server in warehouse/pg. Point at docker compose / RDS instead:
# EOD_DATABASE_URL=postgresql://eod:eod@localhost:5432/eod
# Alerts to Slack (only when alerts.channel = slack):
SLACK_WEBHOOK_URL=
# Governance hub (optional): GOVERNANCE_DATABASE_URL=postgresql://... · GOVERNANCE_TELEMETRY=off
