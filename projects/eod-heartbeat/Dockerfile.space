# Hosted demo image (Hugging Face Space, Docker SDK). Local equivalent:
#   docker build -f Dockerfile.space -t eod-demo . && docker run -p 7860:7860 eod-demo
# Embedded Postgres (pgserver) inside the container; mock models only, no API keys.
# Each visitor gets a private copy of the files and their own database (CREATE DATABASE … TEMPLATE eod).
FROM python:3.11-slim
RUN useradd -m -u 1000 user
ENV HOME=/home/user PATH=/home/user/.local/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR /app
COPY --chown=user . .
USER user
RUN pip install --no-cache-dir --user -e ".[ui]"
# Build the baseline every visitor's database is copied from; stop Postgres cleanly so the layer is consistent.
RUN EOD_PG_CLEANUP=stop GOVERNANCE_TELEMETRY=off eodhb all
ENV PORTFOLIO_DEMO=1
EXPOSE 7860
CMD ["streamlit", "run", "src/eod_heartbeat/ui.py", "--server.port=7860", "--server.address=0.0.0.0", \
     "--server.headless=true", "--server.enableXsrfProtection=false", "--server.enableCORS=false"]
