# Copy to .env (git-ignored). Nothing here is needed offline (`make all`, `pytest`).
# --- required in the live service (EDITORIAL_REQUIRE_SECRETS=1 refuses to start without it) ---
EDITORIAL_LINK_SECRET=        # signs the pick / dismiss links in the topic email:  openssl rand -hex 32
# --- who gets the topic email, and where links point ---
EDITORIAL_EMAIL=              # the owner's address (falls back to DIGEST_EMAIL / GOVERNANCE_ALERT_EMAIL)
EDITORIAL_PUBLIC_URL=         # e.g. https://demos.example.com/editorial-agents
EDITORIAL_REPO=               # owner/name of the blog repo (draft-post pull requests); default <owner>/ai-portfolio
# --- settings overrides ---
EDITORIAL_QUEUE_SIZE=         # default 10
EDITORIAL_DIGEST_DAY=         # mon … sun, default mon
EDITORIAL_CLASSIFIER_MODEL=   # local-gemma to classify with Ollama; default is the offline mock
# --- Reddit's official API (optional; without it the scout skips Reddit) ---
REDDIT_CLIENT_ID=             # create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_SECRET=
# --- email: the demo host's SMTP settings (Resend works) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
